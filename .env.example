# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA vai para o git (contém senhas).

# Chave usada pelo Flask para assinar cookies de sessão (qualquer string longa e aleatória)
SECRET_KEY=

# Banco de dados da aplicação (SQL Server)
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Opcional — tem padrão "ODBC Driver 18 for SQL Server" se não informado
DB_DRIVER=

# Usuário com permissão de criar tabelas (usado só pelo criar_banco.py)
DB_DDL_USERNAME=
DB_DDL_PASSWORD=

# API do Protheus (autenticação do login)
PROTHEUS_BASE_URL=
PROTHEUS_USER=
PROTHEUS_PASSWORD=
# Opcional — timeout em segundos, padrão 10
PROTHEUS_TIMEOUT=
